# =============================================================
# Multi-Provider LLM Gateway — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================

# ── Required (server will refuse to start in production if missing) ──────────

# 256-bit random string used to sign session JWTs.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# MySQL connection string.
DATABASE_URL=mysql://user:password@localhost:3306/llm_gateway

# OAuth server base URL (Manus auth service).
OAUTH_SERVER_URL=https://

# Vite app identifier registered with the OAuth provider.
VITE_APP_ID=

# Manus built-in Forge API — base URL and API key for storage and notifications.
BUILT_IN_FORGE_API_URL=https://
BUILT_IN_FORGE_API_KEY=

# OpenID of the owner account (used for admin checks and notifications).
OWNER_OPEN_ID=

# ── Docker Compose MySQL credentials (required when using docker-compose.yml) ─

MYSQL_USER=gateway
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# ── Optional — provider API keys ─────────────────────────────────────────────
# When absent the gateway uses its built-in demo adapter.
# Get a Groq key at: https://console.groq.com/keys
GROQ_API_KEY=
# Get a Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── Optional — server config ──────────────────────────────────────────────────
# Port the HTTP server listens on. Defaults to 3000.
PORT=3000

# Comma-separated list of allowed CORS origins.
# Leave empty for same-origin only (recommended for production).
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=

# Log level: trace | debug | info | warn | error | fatal. Defaults to info.
LOG_LEVEL=info
